# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://finstatement_user:strongpassword@localhost:5432/finstatement_db"

# ─── Redis (session store + BullMQ) ─────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET="replace-with-64-char-random-hex"
SESSION_SECRET="replace-with-64-char-random-hex"
JWT_EXPIRES_IN="8h"

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:5173"

# ─── File upload ─────────────────────────────────────────────────────────────
MAX_TB_FILE_SIZE_MB=20
MAX_TB_VERSIONS=5
