# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://finstatement_user:strongpassword@localhost:5432/finstatement_db"

# ─── Redis (session store + rate limiting + reset/invite tokens) ────────────
# Required for anything beyond a single local dev instance — see src/config/redis.js
REDIS_URL="redis://localhost:6379"

# ─── DB pool sizing ──────────────────────────────────────────────────────────
# See comment in src/config/db.js for how to size this against your Neon plan
# and instance count. Defaults to 3 (safe for free tier) if unset.
DB_CONNECTION_LIMIT=3

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET="replace-with-64-char-random-hex"
SESSION_SECRET="replace-with-64-char-random-hex"
JWT_EXPIRES_IN="8h"

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:5173"

# ─── File upload ─────────────────────────────────────────────────────────────
MAX_TB_FILE_SIZE_MB=20
MAX_TB_VERSIONS=5
